{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fer-mujoco-sysid:schema:normalized-trajectory:1",
  "title": "Canonical normalized FER trajectory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "content_sha256",
    "created_at",
    "source_run",
    "protocol",
    "protocol_segment_id",
    "lineage_group_id",
    "converter",
    "joint_order",
    "canonical_clock",
    "clock_alignments",
    "sample_grid",
    "state_time",
    "control_time",
    "initial_state",
    "signals",
    "quality"
  ],
  "properties": {
    "schema": {
      "const": "fer-mujoco-sysid/normalized-trajectory@1"
    },
    "artifact_id": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/artifactId"
    },
    "content_sha256": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/sha256"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_run": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/artifactReference",
      "properties": {
        "schema": {
          "const": "fer-mujoco-sysid/acquisition-run@1"
        }
      }
    },
    "protocol": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/artifactReference",
      "properties": {
        "schema": {
          "const": "fer-mujoco-sysid/motion-protocol@1"
        }
      }
    },
    "protocol_segment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "lineage_group_id": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/artifactId"
    },
    "converter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "software",
        "configuration"
      ],
      "properties": {
        "software": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/softwareComponent"
        },
        "configuration": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/fileReference"
        }
      }
    },
    "joint_order": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/ferArmJointOrder"
    },
    "canonical_clock": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/clockDescriptor"
    },
    "clock_alignments": {
      "type": "array",
      "items": {
        "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/clockAlignment"
      }
    },
    "sample_grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "period_ns"
      ],
      "properties": {
        "kind": {
          "const": "uniform"
        },
        "period_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "state_time": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/numericArrayReference",
      "properties": {
        "key": {
          "const": "state_time_s"
        },
        "dtype": {
          "const": "<f8"
        },
        "unit": {
          "const": "s"
        }
      }
    },
    "control_time": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/numericArrayReference",
      "properties": {
        "key": {
          "const": "control_time_s"
        },
        "dtype": {
          "const": "<f8"
        },
        "unit": {
          "const": "s"
        }
      }
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_rad",
        "velocity_rad_s"
      ],
      "properties": {
        "position_rad": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/vector7"
        },
        "velocity_rad_s": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/vector7"
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/normalizedSignal"
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "report"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "warning",
            "fail"
          ]
        },
        "report": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/fileReference"
        },
        "valid_sample_mask": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/numericArrayReference",
          "properties": {
            "dtype": {
              "const": "|b1"
            },
            "unit": {
              "const": "1"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "normalizedSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor",
        "array",
        "time_base",
        "source_binding",
        "resampling",
        "numeric_transform"
      ],
      "properties": {
        "descriptor": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/signalDescriptor"
        },
        "array": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/numericArrayReference"
        },
        "time_base": {
          "type": "string",
          "enum": [
            "state",
            "control"
          ]
        },
        "source_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_signal_name",
            "source_clock_id",
            "start_message_index",
            "end_message_index_exclusive",
            "start_timestamp_ns",
            "end_timestamp_ns"
          ],
          "properties": {
            "raw_signal_name": {
              "type": "string",
              "minLength": 1
            },
            "source_clock_id": {
              "type": "string",
              "minLength": 1
            },
            "start_message_index": {
              "type": "integer",
              "minimum": 0
            },
            "end_message_index_exclusive": {
              "type": "integer",
              "minimum": 1
            },
            "start_timestamp_ns": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "end_timestamp_ns": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          }
        },
        "resampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "applied_time_shift_s"
          ],
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "none",
                "zero_order_hold",
                "linear",
                "nearest"
              ]
            },
            "applied_time_shift_s": {
              "type": "number"
            }
          }
        },
        "numeric_transform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scale",
            "offset"
          ],
          "properties": {
            "scale": {
              "type": "number"
            },
            "offset": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
