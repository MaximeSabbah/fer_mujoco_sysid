{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fer-mujoco-sysid:schema:motion-protocol:1",
  "title": "FER motion protocol artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "content_sha256",
    "title",
    "description",
    "family_id",
    "created_at",
    "generator",
    "joint_order",
    "command_interface",
    "sample_period_ns",
    "arrays",
    "segments",
    "start_state",
    "end_state",
    "context",
    "constraint_profile"
  ],
  "properties": {
    "schema": {
      "const": "fer-mujoco-sysid/motion-protocol@1"
    },
    "artifact_id": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/artifactId"
    },
    "content_sha256": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/sha256"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/artifactId"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "software",
        "seed",
        "configuration"
      ],
      "properties": {
        "software": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/softwareComponent"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "configuration": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/fileReference"
        },
        "analytic_definition": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/fileReference"
        }
      }
    },
    "joint_order": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/ferArmJointOrder"
    },
    "command_interface": {
      "type": "string",
      "enum": [
        "joint_trajectory",
        "joint_effort"
      ]
    },
    "sample_period_ns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "arrays": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_from_start",
        "desired_position",
        "desired_velocity",
        "desired_acceleration"
      ],
      "properties": {
        "time_from_start": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/numericArrayReference",
          "properties": {
            "dtype": {
              "const": "<i8"
            },
            "unit": {
              "const": "ns"
            }
          }
        },
        "desired_position": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/numericArrayReference",
          "properties": {
            "dtype": {
              "const": "<f8"
            },
            "unit": {
              "const": "rad"
            }
          }
        },
        "desired_velocity": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/numericArrayReference",
          "properties": {
            "dtype": {
              "const": "<f8"
            },
            "unit": {
              "const": "rad/s"
            }
          }
        },
        "desired_acceleration": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/numericArrayReference",
          "properties": {
            "dtype": {
              "const": "<f8"
            },
            "unit": {
              "const": "rad/s^2"
            }
          }
        },
        "desired_effort_feedforward": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/numericArrayReference",
          "properties": {
            "dtype": {
              "const": "<f8"
            },
            "unit": {
              "const": "N*m"
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "kind",
          "start_index",
          "end_index_exclusive",
          "analysis_eligible"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "approach",
              "hold",
              "excitation",
              "return",
              "settle",
              "diagnostic"
            ]
          },
          "start_index": {
            "type": "integer",
            "minimum": 0
          },
          "end_index_exclusive": {
            "type": "integer",
            "minimum": 1
          },
          "analysis_eligible": {
            "type": "boolean"
          },
          "exclusion_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "start_state": {
      "$ref": "#/$defs/boundaryState"
    },
    "end_state": {
      "$ref": "#/$defs/boundaryState"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_model",
        "end_effector_id",
        "payload"
      ],
      "properties": {
        "source_model": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/sourceDocument"
        },
        "end_effector_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/payload"
        },
        "scene": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/fileReference"
        }
      }
    },
    "constraint_profile": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/fileReference"
    }
  },
  "$defs": {
    "boundaryState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_rad",
        "velocity_rad_s"
      ],
      "properties": {
        "position_rad": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/vector7"
        },
        "velocity_rad_s": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/vector7"
        }
      }
    }
  }
}
