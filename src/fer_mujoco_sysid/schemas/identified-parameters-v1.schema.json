{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fer-mujoco-sysid:schema:identified-parameters:1",
  "title": "Canonical FER identified-parameter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "content_sha256",
    "created_at",
    "source_model",
    "joint_order",
    "parameterization_id",
    "payload",
    "model_parameters",
    "nuisance_parameters"
  ],
  "properties": {
    "schema": {
      "const": "fer-mujoco-sysid/identified-parameters@1"
    },
    "artifact_id": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/artifactId"
    },
    "content_sha256": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/sha256"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_model": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/sourceDocument"
    },
    "joint_order": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/ferArmJointOrder"
    },
    "parameterization_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/payload"
    },
    "model_parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameterGroup",
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "joint_frictionloss",
              "joint_damping",
              "joint_armature",
              "body_mass_com",
              "body_inertia",
              "terminal_composite_inertia"
            ]
          }
        }
      }
    },
    "nuisance_parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameterGroup",
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "control_delay",
              "torque_scale",
              "sensor_bias"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "parameterGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "family",
        "target",
        "stage_id",
        "optimization_transform",
        "physical_constraint",
        "retained",
        "components"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "family": {
          "type": "string",
          "enum": [
            "control_delay",
            "torque_scale",
            "sensor_bias",
            "joint_frictionloss",
            "joint_damping",
            "joint_armature",
            "body_mass_com",
            "body_inertia",
            "terminal_composite_inertia"
          ]
        },
        "target": {
          "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/parameterTarget"
        },
        "stage_id": {
          "type": "string",
          "minLength": 1
        },
        "optimization_transform": {
          "type": "string",
          "enum": [
            "identity",
            "log",
            "pseudo_inertia_cholesky"
          ]
        },
        "physical_constraint": {
          "type": "string",
          "enum": [
            "box",
            "nonnegative",
            "positive",
            "physically_consistent_inertia"
          ]
        },
        "retained": {
          "type": "boolean"
        },
        "decision_reason": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:fer-mujoco-sysid:schema:common:1#/$defs/parameterComponent"
          }
        },
        "conditioning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dimension",
            "effective_rank",
            "sigma_min_over_sigma_max",
            "max_absolute_correlation",
            "multistart_score_spread"
          ],
          "properties": {
            "dimension": {
              "type": "integer",
              "minimum": 1
            },
            "effective_rank": {
              "type": "integer",
              "minimum": 0
            },
            "sigma_min_over_sigma_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_absolute_correlation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "multistart_score_spread": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
