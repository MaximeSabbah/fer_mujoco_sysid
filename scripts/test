#!/usr/bin/env bash
set -euo pipefail

# A sourced ROS environment exposes unrelated pytest plugins that are not
# dependencies of this standalone project. Disable their automatic discovery.
export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
export MPLCONFIGDIR="${FER_SYSID_MPLCONFIGDIR:-/tmp/fer_mujoco_sysid_mpl}"
export UV_CACHE_DIR="${FER_SYSID_UV_CACHE_DIR:-/tmp/fer_mujoco_sysid_uv_cache}"

# Fast development loop: the multi-minute optimizer-driven recovery gates are
# excluded here. Run ./scripts/test-all (everything) before review handoff.
exec uv run --locked pytest -m "not slow" "$@"
