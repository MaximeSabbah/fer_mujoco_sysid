#!/usr/bin/env bash
set -euo pipefail

# Fit a model from recorded runs and report on it.
#
#   ./scripts/identify runs/            # every recording under runs/
#   ./scripts/identify runs/ --output docs/real_identification
#
# Reads only recording bundles, so it does not care whether the arm was
# simulated or real — and needs no ROS. Recordings come from
# `./scripts/run-protocol <id> --record <dir>`.

# The fit takes many minutes on a full campaign. Unbuffered, so its progress
# is visible while it runs rather than arriving all at once at the end.
export PYTHONUNBUFFERED=1
export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
export MPLCONFIGDIR="${FER_SYSID_MPLCONFIGDIR:-/tmp/fer_mujoco_sysid_mpl}"
export UV_CACHE_DIR="${FER_SYSID_UV_CACHE_DIR:-/tmp/fer_mujoco_sysid_uv_cache}"

exec uv run --locked python -m fer_mujoco_sysid.identify "$@"
