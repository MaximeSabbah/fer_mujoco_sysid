#!/usr/bin/env bash
set -euo pipefail

# The complete gate suite, including the slow synthetic-recovery fits.
# This is the run that must be green before a review handoff.
export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
export MPLCONFIGDIR="${FER_SYSID_MPLCONFIGDIR:-/tmp/fer_mujoco_sysid_mpl}"
export UV_CACHE_DIR="${FER_SYSID_UV_CACHE_DIR:-/tmp/fer_mujoco_sysid_uv_cache}"

exec uv run --locked pytest "$@"
